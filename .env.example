# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ACCESS_PASSWORD: Mật khẩu bảo vệ máy chủ và API (Tùy chọn)
# Nếu để trống: Máy chủ chạy ở chế độ cá nhân (mở tự do không yêu cầu mật khẩu).
# Nếu có đặt mật khẩu: Toàn bộ API /api/* sẽ yêu cầu xác thực trước khi sử dụng.
ACCESS_PASSWORD=""

# TRUST_PROXY_HOPS: Số lượng hop proxy tin tưởng phía trước load balancer (mặc định 1)
TRUST_PROXY_HOPS=1

# REDIS_URL: URL kết nối tới Redis (ví dụ: redis://localhost:6379)
# Nếu có cấu hình, hệ thống sẽ sử dụng rate limiter và auth store phân tán bằng Redis thay vì in-memory.
# REDIS_URL=""

# VITE_GOOGLE_CLIENT_ID: OAuth 2.0 Client ID loại Web Application (Tùy chọn)
# Dùng cho tính năng đăng nhập Google & đồng bộ Google Drive trực tiếp từ trình duyệt (OAuth PKCE).
VITE_GOOGLE_CLIENT_ID=""

# VITE_GOOGLE_PICKER_API_KEY: Browser API Key cho Google Picker API (Tùy chọn)
# Dùng để mở hộp thoại Google Picker giúp cộng tác viên chọn và nạp thư mục truyện được chia sẻ.
VITE_GOOGLE_PICKER_API_KEY=""

# VITE_GOOGLE_APP_ID: Google Cloud Project Number (dạng số, Tùy chọn)
# Lấy từ Google Cloud Console -> IAM & Admin -> Settings -> Project number (ví dụ: 123456789012).
# Bắt buộc khi dùng Google Picker với quyền drive.file để liên kết quyền truy cập per-file cho access token.
VITE_GOOGLE_APP_ID=""

